{
  "name": "web-claim",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --config vitest.config.mts && vitest run --config vitest.mcp.config.mts",
    "dev": "npm run db:setup && wrangler dev",
    "db:setup": "wrangler d1 migrations apply DB --local && wrangler d1 execute DB --local --file=seed.sql",
    "db:reset": "rm -rf .wrangler/state && npm run db:setup",
    "seed:gen": "tsx scripts/make-seed.ts",
    "mcp": "tsx mcp/server.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "keywords": [],
